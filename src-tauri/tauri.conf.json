{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MuiLabs",
  "version": "0.1.0",
  "identifier": "com.mui.muilabs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MuiLabs",
        "width": 1080,
        "height": 760,
        "minWidth": 420,
        "minHeight": 520,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "heraklessii",
    "copyright": "2026 Mui",
    "shortDescription": "Mui uygulamalarinin vitrini",
    "longDescription": "Mui ailesinin butun uygulamalarini listeleyen, dogru surumu isletim sistemine gore indiren vitrin uygulamasi."
  }
}
